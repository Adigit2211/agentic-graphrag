# Copy to .env and adjust. Nothing here is a secret by default.

# --- LLM (any OpenAI-compatible server; Ollama shown) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
LLM_TIMEOUT_S=120

# --- Embeddings ---
# "sentence-transformers" needs `pip install -e ".[embeddings]"` and downloads the
# model on first use. "hashing" is a lexical-only offline fallback for smoke tests.
EMBEDDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EXTRACTION_MAX_RETRIES=2
MAX_UPLOAD_BYTES=5000000

# --- Retrieval ---
TOP_K=5
GRAPH_HOPS=2
GRAPH_ENTITY_LIMIT=50
RRF_K=60

# --- Agent / API ---
MAX_ITERATIONS=2
QUERY_TIMEOUT_S=180
LOG_LEVEL=INFO
